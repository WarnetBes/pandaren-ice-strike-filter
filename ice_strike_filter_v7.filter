	BaseType == "Inscribed Ultimatum" "Chronicle of Atzoatl" "An Audience with the King"
	SetFontSize 28
	SetTextColor 255 255 0 255
	SetBorderColor 255 150 0 255
	SetBackgroundColor 90 45 0 255
	PlayAlertSound 5 250
	MinimapIcon 0 Yellow Star

