#===============================================================================================================
# Ice Strike Invoker (Monk) — SSF Leveling Filter 27+
# Специально под PandarenDeepRover (Forbidden Rites)
# Что показывает: нужные базы (стаф/EV/ES), резисты, джувелы, валюту, Uncut-гемы.
# Что ПРЯЧЕТ: ненужный мусор (слабое оружие/броня, фляги ниже уровня и т.п.)
#
# ВАЛИДНЫЕ Class в PoE2 (проверено по NeverSink 0.10.4 + комьюнити-фильтрам):
#   Животные:  Rings, Amulets, Belts, Charms
#   Оружие:    Quarterstaves, Staves, Bows, Crossbows, Wands, Sceptres, Spears,
#              One Hand Maces, Two Hand Maces, Claws, Daggers, Flails, Traps, Quivers
#   Броня:     Body Armours, Helmets, Gloves, Boots, Shields, Bucklers, Foci
#   Фляги:     Life Flasks, Mana Flasks (класс "Flasks" ТАКЖЕ существует частично)
#   Гемы:      Skill Gems, Support Gems (Uncut-гемы — это BaseType, не Class!)
#   Другое:    Jewels, Relics, Waystones, Tablet, Currency, Stackable Currency,
#              Socketable (Runes/Soul Cores), Map Fragments, Quest Items
#   !!! "Soul Cores"/"Runes" — это НЕ Class, а BaseType предметов класса Socketable
#   !!! В PoE2 НЕТ Class "Staff" — только "Staves" (и отдельные "Quarterstaves")
#   !!! GemLevel НЕ работает в PoE2 (нет такого поля) — использовать ItemLevel
#   !!! Сопоставление по части имени работает: Class "Hand" = все Hand-классы
#===============================================================================================================
# УСТАНОВКА:
# 1) Положи этот файл в:  %userprofile%\Documents\My Games\Path of Exile 2\
# 2) В игре: Options -> UI (или Game) -> Loot Filter -> выбрать этот фильтр
# 3) При правках файла вручную: Options -> Reload (игра НЕ перезагружает фильтр сама!)
#===============================================================================================================

#--- 1. Голд ----------------------------------------------------------------------------------------------------
Show
	BaseType == "Gold"
	SetFontSize 18
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 255 255
	MinimapIcon 0 Yellow Circle

#--- 2. Валюта (орбы и всё стекуемое) --------------------------------------------------------------------------
Show
	Class == "Stackable Currency"
	SetFontSize 25
	SetTextColor 255 200 0 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 40 30 0 255
	PlayAlertSound 2 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Diamond

#--- 3. Uncut гемы (все — всегда) ------------------------------------------------------------------------------
Show
	BaseType "Uncut Skill Gem" "Uncut Support Gem" "Uncut Spirit Gem"
	SetFontSize 28
	SetTextColor 0 240 240 255
	SetBorderColor 0 240 240 255
	SetBackgroundColor 0 40 40 255
	PlayAlertSound 3 300
	PlayEffect Cyan
	MinimapIcon 0 Cyan Star

#--- 4. Готовые гемы (Skill/Support) ---------------------------------------------------------------------------
Show
	Class == "Skill Gems" "Support Gems"
	SetFontSize 25
	SetTextColor 0 240 240 255
	SetBorderColor 0 240 240 255

#--- 5. Джувелы и Релики (для Darkness Enthroned / сокетов позже) ----------------------------------------------
Show
	Class == "Jewels" "Relics"
	SetFontSize 27
	SetTextColor 220 120 255 255
	SetBorderColor 220 120 255 255
	SetBackgroundColor 40 0 60 255
	PlayAlertSound 4 300
	PlayEffect Pink
	MinimapIcon 0 Pink Hexagon

#--- 6. Уники (всегда, все) ------------------------------------------------------------------------------------
Show
	Rarity Unique
	SetFontSize 28
	SetTextColor 255 180 0 255
	SetBorderColor 255 180 0 255
	SetBackgroundColor 60 30 0 255
	PlayAlertSound 5 300
	PlayEffect Orange
	MinimapIcon 0 Orange Star

#--- 7. СТАФ (quarterstaves) — твоё оружие, смотрим все редкие ------------------------------------------------
Show
	Class == "Quarterstaves"
	Rarity Rare
	SetFontSize 25
	SetTextColor 255 255 255 255
	SetBorderColor 255 150 0 255
	SetBackgroundColor 60 25 0 255
	MinimapIcon 1 Orange Diamond

#--- 8. Тело/Шлем: гибрид EV+ES (базы твоего билда) — редкость Rare ------------------------------------------
Show
	Class == "Body Armours" "Helmets"
	Rarity Rare
	SetFontSize 24
	SetTextColor 255 255 255 255
	SetBorderColor 200 200 200 255
	SetBackgroundColor 30 30 40 255

#--- 9. Кольца/Амулеты/Пояса (Rare) — сюда смотрим на резисты ------------------------------------------------
Show
	Class == "Rings" "Amulets" "Belts"
	Rarity Rare
	SetFontSize 25
	SetTextColor 255 220 120 255
	SetBorderColor 255 200 80 255
	SetBackgroundColor 50 40 0 255
	MinimapIcon 1 Yellow Diamond

#--- 10. Перчатки/Ботинки (Rare) -------------------------------------------------------------------------------
Show
	Class == "Gloves" "Boots"
	Rarity Rare
	SetFontSize 24
	SetTextColor 255 255 255 255
	SetBorderColor 150 150 150 255
	SetBackgroundColor 25 25 25 255

#--- 11. Сокетируемые (Runes / Soul Cores) — крафт, по желанию ----------------------------------------------
Show
	Class == "Socketable"
	SetFontSize 24
	SetTextColor 150 255 150 255
	SetBorderColor 150 255 150 255

#--- 12. Фляги/Чармы — нужных уровней --------------------------------------------------------------------------
Show
	Class == "Life Flasks" "Mana Flasks" "Charms"
	SetFontSize 21
	SetTextColor 200 255 200 255
	SetBorderColor 100 160 100 255

#--- 13. ПРОЧЕЕ: редкое оружие (для утилити/альтернатив) ------------------------------------------------------
Show
	Class == "Bows" "Crossbows" "Sceptres" "Wands" "Staves" "Spears" "Bucklers" "Shields" "Foci"
	Rarity Rare
	SetFontSize 21
	SetTextColor 220 220 220 255
	SetBorderColor 100 100 100 255

#--- 14. Всё остальное, что не подпало — ПРЯЧЕМ ПОЛНОСТЬЮ ------------------------------------------------------
Hide
	SetFontSize 10
	SetTextColor 100 100 100 255