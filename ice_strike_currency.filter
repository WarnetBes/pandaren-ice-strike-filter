	BaseType == "Fracturing Orb" "Perfect Chaos Orb"
	SetFontSize 28
	SetTextColor 255 240 180 255
	SetBorderColor 255 130 0 255
	SetBackgroundColor 150 60 0 255
	PlayAlertSound 6 300
	PlayEffect Orange
	MinimapIcon 0 Orange Star

