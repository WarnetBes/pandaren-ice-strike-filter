#===============================================================================
# CURRENCY + CRAFT + CONSUMABLES + MAPS LOOT FILTER v1.5-A (pandaren-ice-strike-filter, 10.11.2026)
# Companion to ice_strike_filter_v9 (duet). Pure-currency view.
# CHANGES v1.5-A: MIRROR gets its own SINGLE TOP block (T-0a) above everything:
#   Divine Orb & Hinekora's Lock & Perfect Exalted follow in T-0b. Both tiers
#   loudest (font 28, sound 5/300, yellow star + beam). First-match-wins ->
#   Mirror is the #1 priority, Divine is #2.
#
# TIERS:
#   T-0a  MIRROR OF KALANDRA   - sole top priority
#   T-0b  Divine / Hinekora / Perfect Exalted
#   T1    Top orbs             - loud
#   T2    Mechanic forms       - medium
#   T3    Gold                 - quiet
#   T4    Rest Stackable Currency
#   C1-C7 Craft/omens/cores/coins
#   D1-D5 Waystones + Tablets
#   V1-V4 Valuables safety
#   FINAL hide everything else
#
# INSTALL: copy to Documents\My Games\Path of Exile 2\ice_strike_currency.filter
# In game: Options -> UI -> Loot Filter -> ice_strike_currency -> Reload
#===============================================================================

#--- T-0a. MIRROR OF KALANDRA (THE single top loot -> loudest) -----------------
Show
	BaseType == "Mirror of Kalandra"
	SetFontSize 28
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 0 255
	SetBackgroundColor 200 0 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- T-0b. DIVINE + HINEKORA + PERFECT EXALTED (top value, right after Mirror) --
Show
	BaseType == "Divine Orb" "Hinekora's Lock" "Perfect Exalted Orb"
	SetFontSize 28
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 0 255
	SetBackgroundColor 130 30 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- T1. TOP ORBS + FORBIDDEN RITES MECHANIC CURRENCY --------------------------
Show
	BaseType == "Exalted Orb" "Greater Exalted Orb" "Orb of Annulment" "Fracturing Orb" "Eternal Orb" "Vaal Orb" "Perfect Chaos Orb" "Cryptic Key" "Shattered Triskelion" "Liquid Verisium" "Exceptional Verisium" "Perfect Jeweller's Orb" "Greater Jeweller's Orb"
	SetFontSize 28
	SetTextColor 255 200 0 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 60 40 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- T2. MECHANIC CURRENCY (Aldur/Kalguur forms, catalyzers, breachstones) ------
Show
	BaseType "Thaumaturgic Flux" "Starlit Ore" "Alloy" "Catalyst" "Breachstone" "Breachlord"
	SetFontSize 25
	SetTextColor 255 200 0 255
	SetBorderColor 255 160 0 255
	SetBackgroundColor 45 35 0 255
	PlayAlertSound 3 250
	PlayEffect Yellow
	MinimapIcon 1 Yellow Diamond

#--- T2b. BREACH SPLINTERS full stacks (StackSize >= 15; Class-gated) ----------
Show
	Class == "Stackable Currency"
	BaseType "Splinter"
	StackSize >= 15
	SetFontSize 25
	SetTextColor 255 120 255 255
	SetBorderColor 200 80 255 255
	SetBackgroundColor 50 0 60 255
	PlayAlertSound 3 250
	MinimapIcon 1 Purple Diamond

