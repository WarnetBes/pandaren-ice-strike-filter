#===============================================================================
# CURRENCY + CRAFT + CONSUMABLES + MAPS LODOT FILTER v1.4 XCOMPACT (pandaren-ice-strike-filter, 09.11.2026)
# Companion to ice_strike_filter_v9 (duet). This filter shows currency, crafting
# materials, consumables, waystones and tablets. Everything else (gear, gems,
# uniques, runes, keys, flasks, charms, breach splinter maps) is HIDDEN.
#
# CHANGES v1.5 (09.11): VALUABLES - top-value items guaranteed visible per owner:
#   V1 Time-Lost jewels (4, explicit list) mega-loud; V2 ALL UNIQUES ENABLED
#   (Mageblood ~220div / Headhunter ~33div / Morior Invictus ~30div live market);
#   V3 Uncut Spirit Gem + Uncut Skill Gem 18+ loud, lesser uncut visible.
# CHANGES v1.4 (09.11): XCOMPACT - top tier capped at 28 per owner (small monitor);
#   ladder: 34->28, 33->27, 31->25, 29->24, 27->22, 26->21, Gold->18; hierarchy kept.
# CHANGES v1.3 (09.11): COMPACT - all label fonts reduced ~25% for small monitors
#   (45->34, 44->33, 42->31, 40->29, 38->27, 36->26, Gold 32->21); tier hierarchy kept.
# CHANGES v1.2 (09.11): + waystones (tiered D1-D4, canon v9) and tablets (D5);
#   RUNES REMOVED per owner decision (C3 deleted, C6 now soul cores only -
#   lesser/normal/greater/perfect runes are hidden by the final Hide).
#
# AUDITED against base_items 0.5.5 (build 4.5.5.2, 5496 records):
#   - all T0/T1 orb names verified (20/20 OK)
#   - Splinter x14 / Catalyst x26 / Breachstone x27 - caught by substring
#   - Essence x26 class Stackable Currency -> tiered below
#   - Omen class x50, Augment class x313 (runes + soul cores), Wombgifts x5
#   - "Thaumaturgic Flux" and "Alloy" are DEAD names in 0.5.5 (kept as
#     harmless substring coverage for future patches)
#
# TIERS:
#   T0  Mirror-tier      - 45pt, sound 5/300, star + beam
#   T1  Top orbs         - 45pt, sound 5/300, star + beam (raised vs v9)
#   T2  Mechanic forms   - 42pt, sound 3/250, beam
#   C1  Greater/Perfect Essence - 45pt, sound 4/300, green star
#   C2  Top omens (Greater Exaltation/Annulment/Sinistral+Dextral Coronation)
#                          - 44pt, sound 3/250, blue star
#   C4  Wombgifts (5 kinds, genesis mechanic) - 45pt, sound 5/250, yellow star
#   T3  Gold             - 32pt, quiet by design
#   T4  Rest of Stackable Currency (incl. Lesser/normal essences, splinters
#       small stacks, all other orbs) - 38pt, visible, no sound
#   C5  Other omens      - 40pt, visible, no sound
#   C6  Soul cores (58 kinds) - 38pt, visible, no sound (RUNES HIDDEN per owner)
#   C7  Trial Coins / Barya (5 kinds, trial entry) - 40pt, visible, no sound
#   D1  Waystones T15/T16 - 45pt, sound 6/300, orange star (canon v9)
#   D2  Waystones T13-T14 - 44pt, icon, no ding
#   D3  Waystones T6-T12  - 41pt plain
#   D4  Waystones T1-T5   - 36pt plain
#   D5  Tablets (8 kinds)  - 44pt, sound 2/250, yellow star (canon v9)
#
# OPTIONAL: unique safety net - uncomment block A1 below (uniques are HIDDEN
#   by default in this filter by design).
#
# INSTALL: copy to Documents\My Games\Path of Exile 2\ice_strike_currency.filter
# In game: Options -> UI -> Loot Filter -> ice_strike_currency -> Reload
#
# Syntax verified against official /item-filter/about + NeverSink-PoE2 0.10.4.
#===============================================================================

#--- T0. MIRROR TIER ----------------------------------------------------------
Show
	BaseType == "Mirror of Kalandra" "Hinekora's Lock" "Perfect Exalted Orb" "Divine Orb"
	SetFontSize 28
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 0 255
	SetBackgroundColor 130 30 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- T1. TOP ORBS + FORBIDDEN RITES MECHANIC CURRENCY --------------------------
Show
	BaseType == "Exalted Orb" "Greater Exalted Orb" "Orb of Annulment" "Fracturing Orb" "Eternal Orb" "Vaal Orb" "Perfect Chaos Orb" "Cryptic Key" "Shattered Triskelion" "Liquid Verisium" "Exceptional Verisium" "Perfect Jeweller's Orb" "Greater Jeweller's Orb"
	SetFontSize 28
	SetTextColor 255 200 0 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 60 40 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- T2. MECHANIC CURRENCY (Aldur/Kalguur forms, catalyzers, breachstones) ------
Show
	BaseType "Thaumaturgic Flux" "Starlit Ore" "Alloy" "Catalyst" "Breachstone" "Breachlord"
	SetFontSize 25
	SetTextColor 255 200 0 255
	SetBorderColor 255 160 0 255
	SetBackgroundColor 45 35 0 255
	PlayAlertSound 3 250
	PlayEffect Yellow
	MinimapIcon 1 Yellow Diamond

#--- T2b. BREACH SPLINTERS full stacks (StackSize >= 15; Class-gated: Augment
#     "Ancient Rune of Splinters" is NOT a splinter) --------------------------------
Show
	Class == "Stackable Currency"
	BaseType "Splinter"
	StackSize >= 15
	SetFontSize 25
	SetTextColor 255 120 255 255
	SetBorderColor 200 80 255 255
	SetBackgroundColor 50 0 60 255
	PlayAlertSound 3 250
	MinimapIcon 1 Purple Diamond

#--- C1. GREATER/PERFECT ESSENCE (top craft mods, x26 family) -------------------
Show
	BaseType "Greater Essence" "Perfect Essence"
	SetFontSize 28
	SetTextColor 200 240 120 255
	SetBorderColor 200 240 120 255
	SetBackgroundColor 0 60 0 255
	PlayAlertSound 4 300
	PlayEffect Green
	MinimapIcon 0 Green Star

#--- C2. TOP CRAFT OMENS (regal/exalt/annul helpers) ----------------------------
Show
	BaseType == "Omen of Greater Exaltation" "Omen of Greater Annulment" "Omen of Sinistral Coronation" "Omen of Dextral Coronation"
	SetFontSize 27
	SetTextColor 90 200 255 255
	SetBorderColor 90 200 255 255
	SetBackgroundColor 0 45 70 255
	PlayAlertSound 3 250
	MinimapIcon 0 Blue Star

#--- C4. WOMBGIFTS (genesis mechanic, 5 kinds: Lavish/Ornate/Banded/Signet/Revelatory)
Show
	Class == "Wombgifts"
	SetFontSize 28
	SetTextColor 255 200 120 255
	SetBorderColor 255 160 60 255
	SetBackgroundColor 70 40 0 255
	PlayAlertSound 5 250
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- T3. GOLD (always visible, quiet - mass trash) ------------------------------
Show
	BaseType == "Gold"
	SetFontSize 18
	SetTextColor 170 158 126 255
	MinimapIcon 1 Yellow Circle

#--- T4. ALL REST CURRENCY (scrolls, shards, orbs, lesser essences,
#        splinters small stacks, coins, feathers - visible, no sound) -----------
Show
	Class == "Stackable Currency"
	SetFontSize 22
	SetTextColor 255 200 0 255
	SetBorderColor 180 140 40 255

#--- C5. OTHER OMENS (46 kinds - visible, no sound) -----------------------------
Show
	Class == "Omen"
	SetFontSize 24
	SetTextColor 90 200 255 255
	SetBorderColor 90 200 255 255
	SetBackgroundColor 0 35 55 255
	MinimapIcon 1 Blue Diamond

#--- C6. OTHER AUGMENTS (runes lesser/normal/greater + 58 soul cores) -----------
#--- C6. SOUL CORES ONLY (58 kinds; RUNES REMOVED per owner 09.11 - all runes
#     fall to the final Hide; soul cores stay visible as tradeable craft material)
Show
	Class == "Augment"
	BaseType "Soul Core"
	SetFontSize 22
	SetTextColor 150 255 150 255
	SetBorderColor 120 200 120 255

#--- C7. TRIAL COINS / BARYA (Djinn + Test of Strength/Will/Cunning/Time) --------
Show
	Class == "Trial Coins"
	SetFontSize 24
	SetTextColor 255 200 0 255
	SetBorderColor 200 160 60 255
	MinimapIcon 1 Yellow Diamond

#===============================================================================
# (old optional A1 unique safety net superseded by active block V2 - see VALUABLES)

#--- D1. WAYSTONES T15/T16 (top endgame) ---------------------------------------
Show
	WaystoneTier >= 15
	Class == "Waystones"
	SetFontSize 28
	SetTextColor 255 255 255 255
	SetBorderColor 255 120 0 255
	SetBackgroundColor 110 50 0 255
	PlayAlertSound 6 300
	MinimapIcon 0 Orange Star

#--- D2. WAYSTONES T13-T14 (loud, no ding - canon v9) ---------------------------
Show
	WaystoneTier >= 13
	WaystoneTier <= 14
	Class == "Waystones"
	SetFontSize 27
	SetTextColor 255 255 255 255
	SetBorderColor 255 120 0 255
	SetBackgroundColor 90 40 0 255
	MinimapIcon 0 Orange Circle

#--- D3. WAYSTONES T6-T12 --------------------------------------------------------
Show
	WaystoneTier >= 6
	WaystoneTier <= 12
	Class == "Waystones"
	SetFontSize 25
	SetTextColor 220 220 200 255
	SetBorderColor 200 190 100 255

#--- D4. WAYSTONES T1-T5 ---------------------------------------------------------
Show
	Class == "Waystones"
	SetFontSize 21
	SetTextColor 200 200 200 255

#--- D5. TABLETS (Ritual/Temple/Breach/Abyss/Expedition/Overseer/Irradiated/Delirium, 8 kinds)
Show
	Class == "Tablet"
	SetFontSize 27
	SetTextColor 255 200 0 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 60 40 0 255
	PlayAlertSound 2 250
	MinimapIcon 0 Yellow Star

#--- V1. TIME-LOST JEWELS (top value, explicit == list; unique rarity is also
#     caught by V2 below, this block guarantees mega-loud regardless) ------------
Show
	BaseType == "Time-Lost Ruby" "Time-Lost Emerald" "Time-Lost Sapphire" "Time-Lost Diamond"
	SetFontSize 28
	SetTextColor 255 150 255 255
	SetBorderColor 255 80 255 255
	SetBackgroundColor 70 0 100 255
	PlayAlertSound 5 300
	PlayEffect Pink
	MinimapIcon 0 Pink Star

#--- V2. ALL UNIQUES (VALUABLES SAFETY NET - enabled per owner 09.11:
#     Mageblood ~220 div, Headhunter ~33 div, Morior Invictus ~30 div, Heart of
#     the Well, Doom Span etc are uniques) - loud -------------------------------
Show
	Rarity Unique
	SetFontSize 28
	SetTextColor 255 180 0 255
	SetBorderColor 255 180 0 255
	SetBackgroundColor 60 30 0 255
	PlayAlertSound 5 300
	PlayEffect Orange
	MinimapIcon 0 Orange Star

#--- V3. UNCUT GEMS (top-value trade currency: Spirit Gem always, Skill Gem 18+)
Show
	BaseType == "Uncut Spirit Gem"
	SetFontSize 28
	SetTextColor 255 80 220 255
	SetBorderColor 255 80 220 255
	SetBackgroundColor 60 0 45 255
	PlayAlertSound 5 300
	PlayEffect Pink
	MinimapIcon 0 Pink Star

Show
	BaseType == "Uncut Skill Gem"
	GemLevel >= 18
	SetFontSize 28
	SetTextColor 0 240 240 255
	SetBorderColor 0 240 240 255
	SetBackgroundColor 0 40 40 255
	PlayAlertSound 5 250
	PlayEffect Cyan
	MinimapIcon 0 Cyan Star

#--- V3b. Lesser uncut gems - visible, no sound -----------------------------------
Show
	BaseType "Uncut Skill Gem" "Uncut Support Gem"
	SetFontSize 22
	SetTextColor 0 240 240 255
	SetBorderColor 0 200 200 255

#--- FINAL. EVERYTHING ELSE IS HIDDEN (currency/craft/consumables view) ----------
Hide
	SetFontSize 10
	SetTextColor 100 100 100 255
