#===============================================================================================================
# CLASS FILTER: HUNTRESS — LEVELING (кампания → первый эндгейм)
# Сгенерировано generate.mjs 18.11.2026 из ice_strike_duet.filter (лестница тиров T0–T5 — verbatim, см. duet).
# Стадия LEVELING: гемы/квест/валюта ярко, весь N/M гир виден тускло (блок 26 duet), своё оружие — ярче.
# Оружие класса: "Spears" "Flails" | offhand: "Bucklers"
# В игре: Options -> UI -> Loot Filter -> class_huntress_leveling -> Reload
#===============================================================================================================

#--- 0. T0 «ЗЕРКАЛО»: MIRROR OF KALANDRA (~65кc) — максимальный приоритет -------------------------------------------------------------------------
Show
	BaseType == "Mirror of Kalandra"
	SetFontSize 24
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 0 255
	SetBackgroundColor 200 0 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#-- 0b. T1 «ЛЕГЕНДА»: Hinekora's Lock (~18 755c) — 2-й по цене лут игры
Show
	BaseType == "Hinekora's Lock"
	SetFontSize 24
	SetTextColor 255 220 220 255
	SetBorderColor 255 60 60 255
	SetBackgroundColor 140 0 0 255
	PlayAlertSound 4 300
	PlayEffect Red
	MinimapIcon 0 Red Star

#-- 0c. T3 «ЦЕННЫЙ»: Divine (~10c) + Perfect Exalted (~29c) — перенос из блока 0 (раньше
#   звенели как Mirror). Полный T3-блок валюты см. 10a; этот блок выше ключей, чтобы
#   драгоценности не перебивались категорийными блоками.
Show
	BaseType == "Divine Orb" "Perfect Exalted Orb"
	SetFontSize 23
	SetTextColor 190 255 170 255
	SetBorderColor 120 235 110 255
	SetBackgroundColor 0 60 10 255
	PlayAlertSound 3 250
	MinimapIcon 1 Green Diamond

#--- 1. ГОЛД (тихо, всегда) -----------------------------------------------------------------------------------------
Show
	BaseType == "Gold"
	SetFontSize 14
	SetTextColor 170 158 126 255
	MinimapIcon 1 Yellow Circle

