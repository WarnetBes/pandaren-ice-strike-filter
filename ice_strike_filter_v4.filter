#===============================================================================================================
# Ice Strike Invoker — SSF Filter v4 (ЭНДГЕЙМ L80+, фликер-CI, патч 0.5.5 Forbidden Rites)
# Для PandarenDeepRover, актуализация от 16.10.2026
#
# Отличия v4 от v3 (все имена сверены с base_items 0.5.5 build 4.5.5.2 + NeverSink-PoE2 0.10.4):
#   + Wombgifts (5 шт.) — НОВАЯ механика 0.5.5 (генезис-бижутерия) — раньше молча съедались
#   + ВАЛЮТА ПРОТИРОИРОВАНА (главный фикс v3: Divine Orb и Scroll of Wisdom звенели одинаково):
#     T0 легендар / T1 топ (звук+звезда) / T2 механо-валюта Runes of Aldur (icon) / T3 остальное — тишина
#   + BREACHSTONES тиражированы: Flawless/Pure громче Charged; Plain — тише (Breach = farma-дуэт по плану №514)
#   + Perfect Glacial/Desert Rune — отдельный громкий блок (твои руны резистов, остаток холода −17)
#   + Вэйстоуны: новый верхний тир T15/T16; T13–T14 средне-громко
#   + Omens: звук снят с массы (50 шт. слишком шумели), оставлен топ-крафту (Greater Exaltation/Annulment/Coronation)
# Унаследовано из v3 без изменений: топ-базы гира №251, эссенции, Uncut-гемы, уники, quarterstaves.
#
# Синтаксис: BaseType "X" без == = substring-match (проверено). Class сверены по base_items 0.5.5.
#
# УСТАЛОВКА: %userprofile%\Documents\My Games\Path of Exile 2\ice_strike_filter_v4.filter
# В игре: Options -> UI -> Loot Filter -> выбрать -> Reload
#===============================================================================================================

#--- 0. T0: ЛЕГЕНДАРНАЯ ВАЛЮТА (мега-громко) -------------------------------------------------------------------------
Show
	BaseType == "Mirror of Kalandra" "Hinekora's Lock" "Perfect Exalted Orb" "Divine Orb"
	SetFontSize 48
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 0 255
	SetBackgroundColor 130 30 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- 1. ГОЛД (тихо, всегда) -----------------------------------------------------------------------------------------
Show
	BaseType == "Gold"
	SetFontSize 32
	SetTextColor 170 158 126 255
	MinimapIcon 1 Yellow Circle

#--- 2. КЛЮЧИ ПИНАКЛЯ / СЕЙФА / ЖУРНАЛЫ ЭКСПЕДИЦИИ ------------------------------------------------------------------
Show
	Class == "Pinnacle Keys" "Vault Keys" "Expedition Logbook"
	SetFontSize 46
	SetTextColor 255 255 0 255
	SetBorderColor 255 255 0 255
	SetBackgroundColor 80 60 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- 3. ЭССЕНЦИИ: Greater/Perfect — ГРОМКО (топ-модификаторы для апгрейда гира) -------------------------------------
Show
	BaseType "Greater Essence" "Perfect Essence"
	SetFontSize 46
	SetTextColor 200 240 120 255
	SetBorderColor 200 240 120 255
	SetBackgroundColor 0 60 0 255
	PlayAlertSound 4 300
	PlayEffect Green
	MinimapIcon 0 Green Star

#-- 3b. Эссенции обычные / Lesser
Show
	BaseType "Essence"
	SetFontSize 38
	SetTextColor 160 220 120 255
	SetBorderColor 120 180 100 255

#--- 4. BREACH (фарм-механика №514): осколки/катализсты + КАМНИ ПО ТИРАМ ---------------------------------------------
#-- 4a. Flawless/Pure Breachstone — босс-камни: громко
Show
	BaseType "Flawless Breachstone" "Pure Breachstone"
	SetFontSize 46
	SetTextColor 255 120 255 255
	SetBorderColor 200 80 255 255
	SetBackgroundColor 60 0 70 255
	PlayAlertSound 5 300
	PlayEffect Pink
	MinimapIcon 0 Purple Star

#-- 4b. Enriched/Charged Breachstone — средне-громко
Show
	BaseType "Enriched Breachstone" "Charged Breachstone"
	SetFontSize 43
	SetTextColor 255 120 255 255
	SetBorderColor 200 80 255 255
	SetBackgroundColor 50 0 60 255
	PlayAlertSound 3 200
	MinimapIcon 0 Purple Diamond

#-- 4c. Катализсты + осколки Breach + plain Breachstone (вход в Breach — ловим всё, средне)
Show
	BaseType "Catalyst" "Splinter" "Breachstone" "Breachlord"
	SetFontSize 40
	SetTextColor 255 120 255 255
	SetBorderColor 200 80 255 255
	SetBackgroundColor 50 0 60 255
	MinimapIcon 1 Purple Diamond

#--- 5. WOMBGIFTS — НОВАЯ механика 0.5.5 Forbidden Rites (генезис-бижутерия) — ВСЕ громко ---------------------------
Show
	Class == "Wombgifts"
	SetFontSize 46
	SetTextColor 255 200 120 255
	SetBorderColor 255 160 60 255
	SetBackgroundColor 70 40 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- 6. OMEN'ы: топ-крафт со звуком ----------------------------------------------------------------------------------
Show
	BaseType == "Omen of Greater Exaltation" "Omen of Greater Annulment" "Omen of Sinistral Coronation" "Omen of Dextral Coronation" "Omen of Greater Exaltation"
	SetFontSize 44
	SetTextColor 90 200 255 255
	SetBorderColor 90 200 255 255
	SetBackgroundColor 0 45 70 255
	PlayAlertSound 3 250
	MinimapIcon 0 Blue Star

#-- 6b. Остальные Omens — ярко, но без звука (50 видов очень шумели)
Show
	Class == "Omen"
	SetFontSize 41
	SetTextColor 90 200 255 255
	SetBorderColor 90 200 255 255
	SetBackgroundColor 0 35 55 255
	MinimapIcon 1 Blue Diamond

#--- 7. АУГМЕНТЫ: Perfect Glacial/Desert Rune — РУНЫ РЕЗИСТОВ БИЛДА (остаток холода −17) ----------------------------
Show
	BaseType == "Perfect Glacial Rune" "Perfect Desert Rune"
	SetFontSize 46
	SetTextColor 150 255 150 255
	SetBorderColor 150 255 150 255
	SetBackgroundColor 10 60 10 255
	PlayAlertSound 4 300
	PlayEffect Green
	MinimapIcon 0 Green Star

#-- 7b. Остальные Руны / Soul Cores / Идолы — весь класс Augment
Show
	Class == "Augment"
	SetFontSize 40
	SetTextColor 150 255 150 255
	SetBorderColor 150 255 150 255
	SetBackgroundColor 10 45 10 255
	MinimapIcon 1 Green Diamond

#--- 8. ТАБЛЕТКИ (Ritual/Temple/Breach/Abyss/Expedition/Overseer/Irradiated/Delirium — 8 видов, класс Tablet) --------
Show
	Class == "Tablet"
	SetFontSize 44
	SetTextColor 255 200 0 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 60 40 0 255
	PlayAlertSound 2 250
	MinimapIcon 0 Yellow Star

#--- 9. ВЭЙСТОУНЫ ---------------------------------------------------------------------------------------------------
#-- 9a. T15/T16 — топ-эндгейм: громко
Show
	WaystoneTier >= 15
	Class == "Waystones"
	SetFontSize 46
	SetTextColor 255 255 255 255
	SetBorderColor 255 120 0 255
	SetBackgroundColor 110 50 0 255
	PlayAlertSound 6 300
	MinimapIcon 0 Orange Star

#-- 9b. T13–T14: звонок
Show
	WaystoneTier >= 13
	WaystoneTier <= 14
	Class == "Waystones"
	SetFontSize 44
	SetTextColor 255 255 255 255
	SetBorderColor 255 120 0 255
	SetBackgroundColor 90 40 0 255
	PlayAlertSound 6 250
	MinimapIcon 0 Orange Circle

#-- 9c. T6–T12
Show
	WaystoneTier >= 6
	WaystoneTier <= 12
	Class == "Waystones"
	SetFontSize 41
	SetTextColor 220 220 200 255
	SetBorderColor 200 190 100 255

#-- 9d. T1–T5 — мелко
Show
	Class == "Waystones"
	SetFontSize 36
	SetTextColor 200 200 200 255

#--- 10. Валюта T1: ТОП-ОРБЫ + механика Forbidden Rites ---------------------------------------------------------------
# Cryptic Key / Shattered Triskelion / Liquid Verisium — по канону NeverSink-PoE2 (top currency tier)
Show
	BaseType == "Exalted Orb" "Greater Exalted Orb" "Orb of Annulment" "Fracturing Orb" "Eternal Orb" "Vaal Orb" "Perfect Chaos Orb" "Cryptic Key" "Shattered Triskelion" "Liquid Verisium" "Exceptional Verisium"
	SetFontSize 44
	SetTextColor 255 200 0 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 60 40 0 255
	PlayAlertSound 2 250
	MinimapIcon 1 Yellow Diamond

#-- 10b. Валюта T2: механо-валюта Runes of Aldur / Kalguur (частая — icon, без звука)
Show
	BaseType "Thaumaturgic Flux" "Starlit Ore" "Alloy"
	SetFontSize 40
	SetTextColor 255 200 0 255
	SetBorderColor 200 160 60 255
	MinimapIcon 1 Yellow Diamond

#-- 10c. Валюта T3: ОСТАЛЬНОЙ Stackable Currency — тихо (скроллы/осадки не должны звенеть; выше уже поймано всё ценное)
Show
	Class == "Stackable Currency"
	SetFontSize 38
	SetTextColor 255 200 0 255
	SetBorderColor 180 140 40 255

