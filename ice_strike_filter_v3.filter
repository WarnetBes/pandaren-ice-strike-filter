#===============================================================================================================
# Ice Strike Invoker — SSF Filter v3 (ЭНДГЕЙМ: "одежда для роста", L80+)
# Для PandarenDeepRover (Forbidden Rites), актуализация от 10.10.2026
#
# Отличия v3 от v2 (базы проверены poe2db 09–10.10, журнал №251):
#   + ЭНДГЕЙМ-МЕХАНИКИ: Waystones (по тиру), Omens, Augments (Руны/С soul Core/Идолы),
#     Essences (Greater/Perfect — громко), Catalysts, Breach-осколки/камни, Tablets,
#     Pinnacle/Vault ключи. В v2 всё это молча съедалось "Stackable Currency"/Hide.
#   + ТОП-БАЗЫ ПОД ТВОЙ ПЛАН ПИНАКЛЯ (журнал №251):
#     тело EV/ES: Torment Jacket / Devout Garb / Assassin Garb (EV248/ES76)
#     шлем ES:    Ancestral / Kamasan / Sorcerous Tiara + гибрид-маски Soaring/Grinning/Faridun
#     перчатки:   Secured / Vaal / Elegant Wraps (+Sirenscale)
#     сапоги:     Quickslip / Daggerfoot Shoes (+Sekhema)
#     кольца:     Two-Stone (Fire+Cold!) / Ruby / Sapphire — даже Normal для крафта резистов
#     пояса:      Fine / Heavy / Double Belt
#     амулет:     Lunar (ES) / Lapis (Int)
#   − выкинуты левелинг-базы (Tattered Robe, Feathered Tiara и пр.) — на L87 мусор
#   - ЧИСТОТА: слабые фляги (ItemLevel<60) скрыты, редкое чужое оружие — мелко и серо.
#
# Синтаксис сверен с NeverSink-PoE2 (Class "Waystones"/"Omen"/"Augment", WaystoneTier, ItemLevel).
#
# УСТАНОВКА: %userprofile%\Documents\My Games\Path of Exile 2\ice_strike_filter_v3.filter
# В игре: Options -> UI -> Loot Filter -> выбрать -> Reload
#===============================================================================================================

#--- 1. ГОЛД (тихо, всегда) ---------------------------------------------------------------------------------------
Show
	BaseType == "Gold"
	SetFontSize 18
	SetTextColor 170 158 126 255
	MinimapIcon 1 Yellow Circle

#--- 2. КЛЮЧИ ПИНАКЛЯ / СЕЙФА / ЖУРНАЛЫ ЭКСПЕДИЦИИ ---------------------------------------------------------------
Show
	Class == "Pinnacle Keys" "Vault Keys" "Expedition Logbook"
	SetFontSize 28
	SetTextColor 255 255 0 255
	SetBorderColor 255 255 0 255
	SetBackgroundColor 80 60 0 255
	PlayAlertSound 5 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

#--- 3. ЭССЕНЦИИ: Greater/Perfect — ГРОМКО (топ-модификаторы для апгрейда гира) ----------------------------------
Show
	BaseType "Greater Essence" "Perfect Essence"
	SetFontSize 28
	SetTextColor 200 240 120 255
	SetBorderColor 200 240 120 255
	SetBackgroundColor 0 60 0 255
	PlayAlertSound 4 300
	PlayEffect Green
	MinimapIcon 0 Green Star

#-- 3b. Эссенции обычные / Lesser
Show
	BaseType "Essence"
	SetFontSize 24
	SetTextColor 160 220 120 255
	SetBorderColor 120 180 100 255

#--- 4. КАТАЛИСТЫ (Breach) + осколки/камни Breach ----------------------------------------------------------------
Show
	BaseType "Catalyst" "Splinter" "Breachstone" "Breachlord"
	SetFontSize 24
	SetTextColor 255 120 255 255
	SetBorderColor 200 80 255 255
	SetBackgroundColor 50 0 60 255
	PlayEffect Pink Temp
	MinimapIcon 1 Purple Diamond

#--- 5. OMEN'ы (Class — канон NeverSink; все полезны для крафта/лабиринтов) ---------------------------------------
Show
	Class == "Omen"
	SetFontSize 25
	SetTextColor 90 200 255 255
	SetBorderColor 90 200 255 255
	SetBackgroundColor 0 35 55 255
	PlayAlertSound 3 200

#--- 6. АУГМЕНТЫ: Руны / Soul Cores / Идолы (в т.ч. Explosive/Upgrade Runes) — весь класс ------------------------
# ВАЖНО для плана: Glacial Rune (холод) и Desert Rune (огонь) — твои руны резистов!
Show
	Class == "Augment"
	SetFontSize 25
	SetTextColor 150 255 150 255
	SetBorderColor 150 255 150 255
	SetBackgroundColor 10 45 10 255
	MinimapIcon 1 Green Diamond

#--- 7. ТАБЛЕТКИ (Ritual/Temple/Breach/запреты... вся механика карт) ----------------------------------------------
Show
	BaseType "Tablet"
	SetFontSize 27
	SetTextColor 255 200 0 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 60 40 0 255
	PlayAlertSound 2 250
	MinimapIcon 0 Yellow Star

#--- 8. ВЭЙСТОУНЫ ------------------------------------------------------------------------------------------------
#-- 8a. Высокие тиры (T13+): звонок + звезда
Show
	WaystoneTier >= 13
	Class == "Waystones"
	SetFontSize 27
	SetTextColor 255 255 255 255
	SetBorderColor 255 120 0 255
	SetBackgroundColor 90 40 0 255
	PlayAlertSound 6 250
	MinimapIcon 0 Orange Circle

#-- 8b. Средние (T6–T12)
Show
	WaystoneTier >= 6
	WaystoneTier <= 12
	Class == "Waystones"
	SetFontSize 24
	SetTextColor 220 220 200 255
	SetBorderColor 200 190 100 255

#-- 8c. Низкие (T1–T5) — апгрейд-пул для разбора, мелко
Show
	Class == "Waystones"
	SetFontSize 21
	SetTextColor 200 200 200 255

#--- 9. ПРОЧАЯ ВАЛЮТА (орбы, сферы, арбитры — всё стекуемое, что выше не поймано) --------------------------------
Show
	Class == "Stackable Currency"
	SetFontSize 24
	SetTextColor 255 200 0 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 40 30 0 255
	PlayAlertSound 2 250
	PlayEffect Yellow
	MinimapIcon 1 Yellow Diamond

#--- 10. UNCUT-гемы -----------------------------------------------------------------------------------------------
#-- 10a. Uncut SPIRIT Gem (Herald-тройка/Blasphemy — твой резерв-бюджет)
Show
	BaseType == "Uncut Spirit Gem"
	SetFontSize 28
	SetTextColor 255 80 220 255
	SetBorderColor 255 80 220 255
	SetBackgroundColor 60 0 45 255
	PlayAlertSound 5 300
	PlayEffect Pink
	MinimapIcon 0 Pink Star

#-- 10b. Uncut Skill/Support
Show
	BaseType "Uncut Skill Gem" "Uncut Support Gem"
	SetFontSize 28
	SetTextColor 0 240 240 255
	SetBorderColor 0 240 240 255
	SetBackgroundColor 0 40 40 255
	PlayAlertSound 3 300
	PlayEffect Cyan
	MinimapIcon 0 Cyan Star

#--- 11. Готовые гемы --------------------------------------------------------------------------------------------
Show
	Class == "Skill Gems" "Support Gems"
	SetFontSize 24
	SetTextColor 0 240 240 255
	SetBorderColor 0 240 240 255

#--- 12. ДЖЕВЕЛЫ (Heart of the Well / сокеты; все — SSF не разбираем) ---------------------------------------------
Show
	Class == "Jewels" "Talismans"
	SetFontSize 27
	SetTextColor 220 120 255 255
	SetBorderColor 220 120 255 255
	SetBackgroundColor 40 0 60 255
	PlayAlertSound 4 250
	PlayEffect Pink
	MinimapIcon 0 Pink Hexagon

#-- 12b. Релики Sekhema
Show
	BaseType == "Amphora Relic" "Coffer Relic" "Incense Relic" "Seal Relic" "Tapestry Relic" "Urn Relic" "Vase Relic"
	SetFontSize 24
	SetTextColor 0 240 190 255
	SetBorderColor 0 240 190 255
	PlayAlertSound 3 300
	PlayEffect Blue Temp

#--- 13. УНИКИ (всегда; SSF — каждый потенциальный сайдгард) ------------------------------------------------------
Show
	Rarity Unique
	SetFontSize 28
	SetTextColor 255 180 0 255
	SetBorderColor 255 180 0 255
	SetBackgroundColor 60 30 0 255
	PlayAlertSound 5 300
	PlayEffect Orange
	MinimapIcon 0 Orange Star

#===============================================================================================================
# >>>>> ОРУЖИЕ: Quarterstaves <<<<<
#===============================================================================================================

#-- 14a. ТОП-базы стафов (апгрейд Матсьи): даже Magic — под крафт
Show
	Class == "Quarterstaves"
	BaseType == "Aegis Quarterstaff" "Wyrm Quarterstaff" "Lunar Quarterstaff" "Striking Quarterstaff" "Dreaming Quarterstaff" "Guardian Quarterstaff" "Bladed Quarterstaff"
	Rarity Normal Magic
	SetFontSize 27
	SetTextColor 120 255 255 255
	SetBorderColor 0 220 220 255
	SetBackgroundColor 0 40 50 255
	PlayEffect Cyan
	MinimapIcon 1 Cyan Diamond

#-- 14b. Стафы Rare (все базы)
Show
	Class == "Quarterstaves"
	Rarity Rare
	SetFontSize 26
	SetTextColor 255 255 255 255
	SetBorderColor 255 150 0 255
	SetBackgroundColor 60 25 0 255
	MinimapIcon 1 Orange Diamond

#===============================================================================================================
# >>>>> ТОП-БАЗЫ ПОД ПЛАН №251 (Normal/Magic = заготовки под крафт, EB/ES цели) <<<<<
#===============================================================================================================

#--- 15. ТЕЛО EV/ES (DexInt) — приоритет №1: дух + EV + ES («одежда для роста»)
Show
	Class == "Body Armours"
	BaseType == "Assassin Garb" "Devout Garb" "Torment Jacket" "Ascetic Garb" "Clandestine Jacket" "Monastic Garb"
	Rarity Normal Magic
	SetFontSize 27
	SetTextColor 120 255 150 255
	SetBorderColor 120 255 150 255
	SetBackgroundColor 0 50 20 255
	PlayEffect Green
	MinimapIcon 0 Green Diamond

#--- 16. ШЛЕМ ES (Int-тиары — CI-путь) + гибрид-маски DexInt
Show
	Class == "Helmets"
	BaseType == "Ancestral Tiara" "Kamasan Tiara" "Sorcerous Tiara" "Grinning Mask" "Soaring Mask" "Faridun Mask"
	Rarity Normal Magic
	SetFontSize 25
	SetTextColor 200 200 255 255
	SetBorderColor 120 120 255 255
	SetBackgroundColor 20 20 60 255
	MinimapIcon 1 Blue Diamond

#--- 17. ПЕРЧАТКИ (Sirenscale из PoB + топ DexInt Wraps)
Show
	Class == "Gloves"
	BaseType == "Sirenscale Gloves" "Secured Wraps" "Vaal Wraps" "Elegant Wraps"
	Rarity Normal Magic
	SetFontSize 24
	SetTextColor 200 200 255 255
	SetBorderColor 120 120 255 255
	SetBackgroundColor 20 20 60 255
	MinimapIcon 1 Blue Diamond

#--- 18. САПОГИ (Sekhema из PoB + топ DexInt Shoes; Quickslip/Daggerfoot = 30% MS базы)
Show
	Class == "Boots"
	BaseType == "Sekhema Sandals" "Quickslip Shoes" "Daggerfoot Shoes"
	Rarity Normal Magic
	SetFontSize 24
	SetTextColor 200 200 255 255
	SetBorderColor 120 120 255 255
	SetBackgroundColor 20 20 60 255
	MinimapIcon 1 Blue Diamond

#--- 19. КОЛЬЦА — даже Normal/Magic: Two-Stone (Fire+Cold) = твои дыры −37/−24!
Show
	Class == "Rings"
	BaseType == "Two-Stone Ring" "Ruby Ring" "Sapphire Ring" "Topaz Ring" "Amethyst Ring" "Prismatic Ring"
	Rarity Normal Magic
	SetFontSize 25
	SetTextColor 255 220 120 255
	SetBorderColor 255 200 80 255
	SetBackgroundColor 50 40 0 255
	MinimapIcon 0 Yellow Diamond

#--- 20. ПОЯСА + АМУЛЕТЫ — топ-базы под N/M-крафт (чарм-слоты роаллятся отдельно на любой базе)
Show
	Class == "Belts"
	BaseType == "Fine Belt" "Heavy Belt" "Double Belt"
	Rarity Normal Magic
	SetFontSize 24
	SetTextColor 255 220 120 255
	SetBorderColor 255 200 80 255
	SetBackgroundColor 50 40 0 255
	MinimapIcon 1 Yellow Diamond

Show
	Class == "Amulets"
	BaseType == "Lunar Amulet" "Lapis Amulet" "Stellar Amulet" "Veridical Chain"
	Rarity Normal Magic
	SetFontSize 24
	SetTextColor 255 220 120 255
	SetBorderColor 255 200 80 255
	SetBackgroundColor 50 40 0 255
	MinimapIcon 1 Yellow Diamond

#--- 21. RARE-ЦЕЛО (универсальная сетка) ---------------------------------------------------------------------------
#-- 21a. Кольца/Амулеты/Пояса Rare (резисты/ES/дух)
Show
	Class == "Rings" "Amulets" "Belts"
	Rarity Rare
	SetFontSize 25
	SetTextColor 255 220 120 255
	SetBorderColor 255 200 80 255
	SetBackgroundColor 50 40 0 255
	MinimapIcon 1 Yellow Diamond

#-- 21b. Броня/шлемы/перчатки/сапоги Rare
Show
	Class == "Body Armours" "Helmets" "Gloves" "Boots"
	Rarity Rare
	SetFontSize 24
	SetTextColor 255 255 255 255
	SetBorderColor 200 200 200 255
	SetBackgroundColor 30 30 40 255

#--- 22. ЧАРМЫ (все) + ФЛЯГИ только эндгейм-уровня ----------------------------------------------------------------
Show
	Class == "Charms"
	SetFontSize 22
	SetTextColor 200 255 200 255
	SetBorderColor 100 160 100 255

Show
	Class == "Life Flasks" "Mana Flasks"
	ItemLevel >= 60
	SetFontSize 21
	SetTextColor 200 255 200 255
	SetBorderColor 100 160 100 255

#--- 23. Прочее редкое оружие (для золота/разбора) — тише --------------------------------------------------------
Show
	Class == "Bows" "Crossbows" "Sceptres" "Wands" "Staves" "Spears" "Bucklers" "Shields" "Foci" "Quivers" "One Hand Maces" "Two Hand Maces"
	Rarity Rare
	SetFontSize 21
	SetTextColor 220 220 220 255
	SetBorderColor 100 100 100 255

#--- 24. ФИНАЛ: всё непойманное — скрыть -------------------------------------------------------------------------
Hide
	SetFontSize 10
	SetTextColor 100 100 100 255
